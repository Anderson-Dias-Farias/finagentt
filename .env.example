# finagent — copie para .env e preencha o que for usar.
# O .env NAO vai para o git nem para a imagem Docker (ver .gitignore / .dockerignore).
# Em producao (EasyPanel) prefira colar as variaveis no painel do servico: elas tem
# prioridade sobre este arquivo.

# ---------------------------------------------------------------- Postgres
# String de conexao do Postgres. Aceita postgres:// ou postgresql://
#   local:   postgresql://finagent:SENHA@127.0.0.1:5432/finagent
#   EasyPanel (rede interna do projeto): postgresql://finagent:SENHA@finagent_db:5432/finagent?sslmode=disable
# Situacao atual: o journal (sinais/backtest) roda em SQLite. Com esta variavel
# preenchida o /api/state passa a mostrar se o host responde na porta; o banco ainda
# NAO e usado pelo journal. Deixe vazio para seguir 100% SQLite.
DATABASE_URL=

# ---------------------------------------------------------------- storage (SQLite)
# Onde mora journal.db, state.json e backups. Em Docker o volume monta em /data.
# FINAGENT_DATA=/data
# FINAGENT_DB=/data/journal.db
# FINAGENT_STATE=/data/state.json
# FINAGENT_BACKUP_DIR=/data/backups

# rotinas de fundo
FINAGENT_EVAL_INTERVAL=600      # fecha sinais abertos a cada 10 min (segundos)
FINAGENT_BACKUP_INTERVAL=21600  # backup consistente a cada 6h
FINAGENT_BACKUP_KEEP=14         # copias mantidas

# ---------------------------------------------------------------- alertas
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
